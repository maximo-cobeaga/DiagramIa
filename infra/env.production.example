# Copiar a .env.production en la raíz del repo, en el VPS (nunca versionarlo). Lo usan docker compose y el gateway.
# Generar cada secreto con: openssl rand -hex 32

# --- Versión y dominios ---
DIAGRAMIA_RELEASE=                       # SHA corto del commit desplegado: etiqueta las imágenes para poder volver atrás.
DIAGRAMIA_APP_URL=https://app.diagramia.example/
DIAGRAMIA_APP_HOST=app.diagramia.example
DIAGRAMIA_SITE_HOST=diagramia.example
DIAGRAMIA_APP_ORIGIN=https://app.diagramia.example
DIAGRAMIA_WEB_PORT=8080                  # Puerto en 127.0.0.1 al que reenvía el reverse proxy del VPS.
DIAGRAMIA_ALLOWED_ORIGINS=https://app.diagramia.example,https://diagramia.example
# Sólo si el reverse proxy del VPS corre en Docker: su red, para que infra/deploy.sh reconecte el contenedor web.
DIAGRAMIA_PROXY_NETWORK=
DIAGRAMIA_PROXY_ALIAS=diagramia-web

# --- Secretos del servidor ---
DIAGRAMIA_DB_PASSWORD=
DIAGRAMIA_API_TOKEN=                     # Nunca llega al navegador; los visitantes usan la cookie de sesión.
DIAGRAMIA_DOCUMENTS_TOKEN=

# --- Cuenta (Auth0, ADR 047) ---
DIAGRAMIA_OIDC_ISSUER=https://<tenant>.us.auth0.com/
DIAGRAMIA_OIDC_CLIENT_ID=
DIAGRAMIA_OIDC_CLIENT_SECRET=
DIAGRAMIA_OIDC_REDIRECT_URI=https://app.diagramia.example/api/v1/auth/callback
DIAGRAMIA_OIDC_HOME_URL=https://app.diagramia.example/

# --- IA incluida (ADR 045) y antiabuso (ADR 052) ---
OPENAI_API_KEY=
DIAGRAMIA_OPENAI_REASONING_EFFORT=low
DIAGRAMIA_ACCOUNT_PROVIDERS=openai
DIAGRAMIA_DAILY_USD_BUDGET=2
DIAGRAMIA_MONTHLY_USD_BUDGET=20
DIAGRAMIA_SPEND_ALERT_RATIO=0.8
DIAGRAMIA_ALERT_WEBHOOK_URL=                # https://ntfy.sh/<canal-difícil-de-adivinar> (guía, paso 5)

# --- Medición (ADR 046/053) ---
DIAGRAMIA_ADMIN_EMAILS=

# --- Cobro de la suscripción Pro (Paddle, ADR 089). Las tres juntas o ninguna. ---
DIAGRAMIA_PADDLE_ENV=sandbox             # sandbox mientras pruebes; live cuando Paddle apruebe la cuenta real.
DIAGRAMIA_PADDLE_API_KEY=                # Developer Tools → Authentication. En sandbox empieza con pdl_sdbx_.
DIAGRAMIA_PADDLE_WEBHOOK_SECRET=         # Developer Tools → Notifications → el destino https://app.<dominio>/api/v1/billing/webhook
DIAGRAMIA_PADDLE_PRICE_PRO=              # Catalog → Prices: ID (pri_…) del precio mensual de Pro (USD 10).
DIAGRAMIA_PADDLE_PRICE_PRO_YEARLY=       # Opcional: ID (pri_…) del precio anual (USD 40). Sin él no se ofrece el plan anual.
DIAGRAMIA_PADDLE_CLIENT_TOKEN=           # Developer Tools → Authentication → Client-side tokens (test_… o live_…). Es PÚBLICO; nunca pongas acá la clave de API.
# Oferta por tiempo limitado (opcional; ver infra/DEPLOY.md). El descuento se crea antes en Paddle.
# DIAGRAMIA_OFFER_DISCOUNT_ID=dsc_...
# DIAGRAMIA_OFFER_PERCENT=50
# DIAGRAMIA_OFFER_MONTHS=3
# DIAGRAMIA_OFFER_ENDS_AT=2026-11-30T23:59:00-03:00
# DIAGRAMIA_OFFER_WELCOME_HOURS=72

# --- MCP remoto (opcional, P5.2) ---
DIAGRAMIA_MCP_RESOURCE_URL=
DIAGRAMIA_MCP_JWKS_URL=

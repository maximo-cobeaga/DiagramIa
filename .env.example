# Copiar a .env en la raíz (ignorado por Git). Estas variables las lee SOLO el gateway (npm run api).
# Nunca usar el prefijo VITE_: lo que empieza con VITE_ termina en el navegador.

# --- Proveedores de IA ---
ANTHROPIC_API_KEY=
# Modelo de Claude. Por defecto claude-opus-5-5.
DIAGRAMIA_ANTHROPIC_MODEL=
# Servidor compatible con /chat/completions (Ollama, LM Studio, vLLM...). Ej.: http://127.0.0.1:11434/v1
# Con Ollama, iniciá el servidor con OLLAMA_CONTEXT_LENGTH=16384 o más: el prompt de sistema no entra en la ventana por defecto.
# Un modelo local lento necesita además subir DIAGRAMIA_REQUEST_TIMEOUT_MS.
DIAGRAMIA_LOCAL_BASE_URL=
DIAGRAMIA_LOCAL_MODEL=
DIAGRAMIA_LOCAL_API_KEY=
# Otro proveedor remoto que hable el protocolo /chat/completions (compatible con OpenAI), con su propia clave.
# BASE_URL es la URL que va antes de /chat/completions. Consume el presupuesto diario; sin tarifa conocida no se estima el costo.
DIAGRAMIA_COMPAT_LABEL=
DIAGRAMIA_COMPAT_BASE_URL=
DIAGRAMIA_COMPAT_API_KEY=
DIAGRAMIA_COMPAT_MODEL=
# 1 habilita un proveedor de DEMOSTRACIÓN que no es una IA (para probar la interfaz sin credenciales).
DIAGRAMIA_ENABLE_MOCK=

# --- Gateway ---
DIAGRAMIA_API_HOST=127.0.0.1
DIAGRAMIA_API_PORT=8787
# Obligatorio si el host no es loopback.
DIAGRAMIA_API_TOKEN=
DIAGRAMIA_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Corte de gasto: por día (UTC) y por pedido.
DIAGRAMIA_DAILY_TOKEN_BUDGET=400000
DIAGRAMIA_DAILY_USD_BUDGET=2
DIAGRAMIA_REQUESTS_PER_MINUTE=10
DIAGRAMIA_MAX_OUTPUT_TOKENS=8000
DIAGRAMIA_MAX_CONTEXT_CHARS=60000
DIAGRAMIA_REQUEST_TIMEOUT_MS=120000
# Reintentos de reparación cuando el engine rechaza la salida del modelo (1 por defecto, máximo 3). Cada uno consume tokens.
DIAGRAMIA_MAX_REPAIRS=1
# Demora de la demostración, en ms.
DIAGRAMIA_MOCK_DELAY_MS=

# --- Documentos PostgreSQL (P4.2) ---
# Docker Compose escucha sólo en loopback. La contraseña por defecto es únicamente de desarrollo.
DIAGRAMIA_DB_PORT=5433
DIAGRAMIA_DB_PASSWORD=
# Habilita migraciones, readiness y rutas /v1/documents al iniciar el gateway. Usar sólo en el servidor.
DIAGRAMIA_DATABASE_URL=
# Obligatorio junto con DATABASE_URL. Token exclusivo de las rutas de documentos; no poner en VITE_ ni en el navegador.
DIAGRAMIA_DOCUMENTS_TOKEN=
# Sólo para trabajar en un equipo local: permite que el navegador y MCP compartan PostgreSQL sin cuenta.
# Nunca habilitarlo en una instalación pública.
DIAGRAMIA_LOCAL_WORKSPACE=0

# --- Cuenta y nube (OIDC, opcional hasta configurar un proveedor) ---
# Proveedor elegido: Auth0 Universal Login mediante OIDC estándar. También funciona otro issuer compatible.
# Registrar exactamente el callback en el panel del proveedor. En desarrollo: http://127.0.0.1:5173/api/v1/auth/callback
DIAGRAMIA_OIDC_ISSUER=
DIAGRAMIA_OIDC_CLIENT_ID=
DIAGRAMIA_OIDC_CLIENT_SECRET=
DIAGRAMIA_OIDC_REDIRECT_URI=
DIAGRAMIA_OIDC_HOME_URL=

# --- MCP remoto para hosts autorizados (opcional, requiere OIDC y PostgreSQL) ---
# URL pública exacta del recurso; debe terminar en /mcp. En producción, HTTPS.
# Registrar esta misma URL como audience/API identifier en el proveedor OAuth.
DIAGRAMIA_MCP_RESOURCE_URL=
# Endpoint JWKS público del issuer OIDC, en el mismo origen que DIAGRAMIA_OIDC_ISSUER.
DIAGRAMIA_MCP_JWKS_URL=

# --- Todavía sin uso (fases futuras) ---
OPENAI_API_KEY=
GOOGLE_API_KEY=
HIGGSFIELD_API_KEY=

# MCP local: ruta absoluta a UN archivo .diagramia.json de trabajo.
DIAGRAMIA_DOCUMENT=
# MCP compartido: alternativa a DIAGRAMIA_DOCUMENT. El token se configura sólo en el host MCP.
DIAGRAMIA_DOCUMENTS_URL=
DIAGRAMIA_DOCUMENT_ID=
